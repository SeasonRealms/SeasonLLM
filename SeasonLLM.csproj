<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>
		<AssemblyName>SeasonLLM</AssemblyName>
		<RootNamespace>Season.LLM</RootNamespace>
		<PackageId>SeasonLLM</PackageId>
		<Title>SeasonLLM</Title>
		<Authors>SeasonRealms</Authors>
		<Company>SeasonRealms</Company>
		<Description>A small .NET wrapper around `llama.cpp` for local GGUF text generation</Description>
		<PackageTags>llama;llava;ggml;text-generation;ai;seasonengine</PackageTags>
		<PackageProjectUrl>https://github.com/SeasonRealms/SeasonLLM</PackageProjectUrl>
		<RepositoryUrl>https://github.com/SeasonRealms/SeasonLLM</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<Version>0.2.0</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;CS1572;CS1573</NoWarn>

		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0;net10.0-browser</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<IsAndroid Condition="$(TargetFramework.Contains('android'))">true</IsAndroid>
		<IsIOS Condition="$(TargetFramework.Contains('ios'))">true</IsIOS>
		<IsMacCatalyst Condition="$(TargetFramework.Contains('maccatalyst'))">true</IsMacCatalyst>
		<IsWindows Condition="$(TargetFramework.Contains('windows'))">true</IsWindows>

		<IsLinux Condition="'$(TargetFramework)' == 'net10.0'">true</IsLinux>
		<IsBrowser Condition="$(TargetFramework.Contains('browser'))">true</IsBrowser>

		<IsApple Condition="'$(IsIOS)' == 'true' or '$(IsMacCatalyst)' == 'true'">true</IsApple>
		<IsUnixLike Condition="'$(IsAndroid)' == 'true' or '$(IsLinux)' == 'true'">true</IsUnixLike>

		<SupportedOSPlatformVersion Condition="'$(IsIOS)' == 'true'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(IsMacCatalyst)' == 'true'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(IsAndroid)' == 'true'">29.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</TargetPlatformMinVersion>

	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="runtimes\win-x64\native\*" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('runtimes\win-x64\native')" />
		<None Include="runtimes\maccatalyst-arm64\native\*" Pack="true" PackagePath="runtimes/maccatalyst-arm64/native/" Condition="Exists('runtimes\maccatalyst-arm64\native')" />

		<ProjectReference Include="..\SeasonGGML\SeasonGGML.csproj" />
	</ItemGroup>

	<!-- Windows: copy DLLs directly to output root (next to the .exe/.dll) -->
	<ItemGroup Condition="'$(IsWindows)' == 'true'">
		<Content Include="runtimes\win-x64\native\*" Condition="Exists('runtimes\win-x64\native')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>

	<!--
	  Mac Catalyst: libllama.dylib and libmtmd.dylib are the llama.cpp runtime
	  (ggml is statically linked into libllama; otool -L shows no libggml dependency).
	  NativeMethods/MtmdNativeMethods P/Invoke "llama"/"mtmd", so both dylibs must
	  ship in the app bundle. libmtmd re-exports @rpath/libllama.dylib, so libllama
	  must be packaged alongside it; the Apple SDK classifies both as dynamic
	  libraries and places them under Contents/MonoBundle, rewriting the re-export
	  path so it resolves there.
	  Only the dylibs are Content: the folder also holds llama.h, llama-cpp.h,
	  ggml.txt, llama.cpp.txt and README.txt, which have no place in an app bundle
	  (and the Apple SDK warns it cannot compute a PublishFolderType for them).
	-->
	<ItemGroup Condition="'$(IsMacCatalyst)' == 'true'">
		<Content Include="runtimes\maccatalyst-arm64\native\libllama.dylib" Condition="Exists('runtimes\maccatalyst-arm64\native\libllama.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
			<Pack>false</Pack>
		</Content>
		<Content Include="runtimes\maccatalyst-arm64\native\libmtmd.dylib" Condition="Exists('runtimes\maccatalyst-arm64\native\libmtmd.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>

</Project>
